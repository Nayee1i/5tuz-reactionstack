# Порт, на котором запускается сервер
PORT=3001

# Ссылка на твою базу данных PostgreSQL
# ЗАМЕНИ 'postgres' и 'postgres' на свой логин и пароль от базы, если они другие
DATABASE_URL="postgresql://postgres:12345@localhost:5432/skillflow?schema=public"

# Секретный ключ для создания "пропусков" (токенов) при входе
# Можешь оставить этот, он для разработки
JWT_SECRET="super_secret_key_for_skillflow_hackathon_2026"