generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  login         String   @unique
  password_hash String
  full_name     String
  is_admin      Boolean  @default(false)
  created_at    DateTime @default(now())

  @@map("users")
}