datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============ СТАРЫЕ ENUMS (без изменений) ============
enum MeetingStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SkillOutcome {
  DISCUSSED
  CONFIRMED
}

enum ProblemStatus {
  OPEN
  RESOLVED
}

// ============ 🆕 НОВЫЕ ENUMS ============
enum MeetingType {
  ONE_ON_ONE      // Индивидуальная
  TEAM            // Командная
  REVIEW          // Ревью / Оценка
  PLANNING        // Планирование
  RETROSPECTIVE   // Ретроспектива
  OTHER           // Другое
}

enum MeetingLocationType {
  ONLINE          // Онлайн (Zoom, Teams)
  OFFICE          // В офисе
  OFFSITE         // Выездная
  HYBRID          // Гибридная
}

// ============ МОДЕЛИ ============

model Direction {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  users       User[]
  skills      Skill[]

  @@map("directions")
  @@schema("pr")
}

model Department {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  parentId   String?     @map("parent_id") @db.Uuid
  headId     String      @map("head_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  parent     Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children   Department[] @relation("DepartmentHierarchy")
  head       User        @relation("DepartmentHead", fields: [headId], references: [id])
  users      User[]

  @@unique([parentId, name])
  @@map("departments")
  @@schema("pr")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login          String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  
  // 🆕 Новые поля пользователя
  birthDate      DateTime? @map("birth_date")  // Дата рождения

  directionId    String    @map("direction_id") @db.Uuid
  departmentId   String    @map("department_id") @db.Uuid
  isAdmin        Boolean   @default(false) @map("is_admin")
  isActive       Boolean   @default(true) @map("is_active")
  authVersion    Int       @default(1) @map("auth_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  direction      Direction @relation(fields: [directionId], references: [id])
  department     Department @relation(fields: [departmentId], references: [id])
  managedDepartments Department[] @relation("DepartmentHead")
  learningPlans  LearningPlan[] @relation("EmployeePlans")
  createdPlans   LearningPlan[] @relation("CreatorPlans")
  createdMeetings Meeting[] @relation("MeetingCreator")
  reviewedMeetings Meeting[] @relation("MeetingReviewer")
  problems       Problem[]
  
  // 🆕 Новые связи пользователя
  userSkills     UserSkill[]              // Скилы пользователя
  participatedMeetings MeetingParticipant[] // Встречи, где он участник

  @@map("users")
  @@schema("pr")
}

model Skill {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  directionId String    @map("direction_id") @db.Uuid
  name        String
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  direction   Direction @relation(fields: [directionId], references: [id])
  planItems   PlanItem[]
  
  // 🆕 Новая связь
  userSkills  UserSkill[]

  @@unique([directionId, name])
  @@map("skills")
  @@schema("pr")
}

// 🆕 НОВАЯ МОДЕЛЬ: Связь пользователя и скила (многие ко многим)
model UserSkill {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  skillId     String    @map("skill_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id])
  skill       Skill     @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
  @@map("user_skills")
  @@schema("pr")
}

model LearningPlan {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  year       Int
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  employee   User      @relation("EmployeePlans", fields: [employeeId], references: [id])
  creator    User      @relation("CreatorPlans", fields: [createdBy], references: [id])
  planItems  PlanItem[]

  @@unique([employeeId, year])
  @@map("learning_plans")
  @@schema("pr")
}

model PlanItem {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  skillId            String    @map("skill_id") @db.Uuid
  dueDate            DateTime  @map("due_date") @db.Date
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  plan               LearningPlan @relation(fields: [planId], references: [id])
  skill              Skill     @relation(fields: [skillId], references: [id])
  meetingSkills      MeetingSkill[]
  skillConfirmations SkillConfirmation[]

  @@unique([planId, skillId])
  @@map("plan_items")
  @@schema("pr")
}

model Meeting {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId         String        @map("employee_id") @db.Uuid
  createdBy          String        @map("created_by") @db.Uuid
  reviewerId         String?       @map("reviewer_id") @db.Uuid
  status             MeetingStatus @default(DRAFT)
  scheduledAt        DateTime?     @map("scheduled_at")
  occurredAt         DateTime?     @map("occurred_at")
  summary            String?
  draftPayload       Json          @default("{}") @map("draft_payload")
  completionRequestId String?      @unique @map("completion_request_id") @db.Uuid
  version            Int           @default(1)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // 🆕 Новые поля встречи
  type             MeetingType       @default(ONE_ON_ONE) // Тип встречи
  locationType     MeetingLocationType @default(OFFICE) @map("location_type") // Где: онлайн/офис
  location         String?           // Адрес или ссылка на конференцию
  conductorId      String?           @map("conductor_id") @db.Uuid // 🆕 Кто проводит
  resultSummary    String?           @map("result_summary") // 🆕 Итоги встречи
  actionItems      String?           @map("action_items") // 🆕 Задачи по итогам

  employee           User          @relation("MeetingEmployee", fields: [employeeId], references: [id])
  creator            User          @relation("MeetingCreator", fields: [createdBy], references: [id])
  reviewer           User?         @relation("MeetingReviewer", fields: [reviewerId], references: [id])
  meetingSkills      MeetingSkill[]
  meetingLinks       MeetingLink[]
  problems           Problem[]
  
  // 🆕 Новые связи встречи
  conductor          User?         @relation("MeetingConductor", fields: [conductorId], references: [id])
  participants       MeetingParticipant[]

  @@map("meetings")
  @@schema("pr")
}

// 🆕 НОВАЯ МОДЕЛЬ: Участники встречи (многие ко многим)
model MeetingParticipant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId   String    @map("meeting_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  status      String    @default("invited") // invited, confirmed, attended, declined
  createdAt   DateTime  @default(now()) @map("created_at")

  meeting     Meeting   @relation(fields: [meetingId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@map("meeting_participants")
  @@schema("pr")
}

model MeetingSkill {
  meetingId        String      @map("meeting_id") @db.Uuid
  planItemId       String      @map("plan_item_id") @db.Uuid
  outcome          SkillOutcome
  skillNameSnapshot String     @map("skill_name_snapshot")
  comment          String?

  meeting          Meeting     @relation(fields: [meetingId], references: [id])
  planItem         PlanItem    @relation(fields: [planItemId], references: [id])
  skillConfirmation SkillConfirmation?

  @@id([meetingId, planItemId])
  @@unique([meetingId, planItemId, outcome])
  @@map("meeting_skills")
  @@schema("pr")
}

model SkillConfirmation {
  planItemId String @map("plan_item_id") @db.Uuid @id
  meetingId  String @map("meeting_id") @db.Uuid
  outcome    SkillOutcome @default(CONFIRMED)
  createdAt  DateTime @default(now()) @map("created_at")

  planItem     PlanItem @relation(fields: [planItemId], references: [id])
  meetingSkill MeetingSkill @relation(fields: [meetingId, planItemId], references: [meetingId, planItemId])

  @@map("skill_confirmations")
  @@schema("pr")
}

model MeetingLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  title     String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  meeting   Meeting  @relation(fields: [meetingId], references: [id])

  @@unique([meetingId, url])
  @@map("meeting_links")
  @@schema("pr")
}

model Problem {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String        @map("employee_id") @db.Uuid
  meetingId        String        @map("meeting_id") @db.Uuid
  planItemId       String?       @map("plan_item_id") @db.Uuid
  comment          String
  status           ProblemStatus @default(OPEN)
  createdBy        String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  resolvedBy       String?       @map("resolved_by") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at")
  resolutionComment String?      @map("resolution_comment")

  employee         User          @relation(fields: [employeeId], references: [id])
  meeting          Meeting       @relation(fields: [meetingId], references: [id])
  planItem         PlanItem?     @relation(fields: [planItemId], references: [id])
  resolver         User?         @relation("ProblemResolver", fields: [resolvedBy], references: [id])

  @@map("problems")
  @@schema("pr")
}

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
  @@schema("pr")
}