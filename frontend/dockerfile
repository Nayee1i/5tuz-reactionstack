# Используем тот же стабильный образ, что и на бэкенде
FROM node:20-bookworm

WORKDIR /app

# 1. Копируем только файлы зависимостей (для кэширования слоя npm install)
COPY package*.json ./

# 2. Устанавливаем зависимости
RUN npm install

# 3. Копируем весь остальной код приложения
COPY . .

# 4. Открываем порт (3000 - стандартный для Create React App)
EXPOSE 3000

# 5. Запускаем сервер разработки
# HOST=0.0.0.0 нужен, чтобы сервер был доступен извне контейнера (например, через Nginx или проброс портов)
CMD ["sh", "-c", "HOST=0.0.0.0 npm start"]