FROM node:lts-alpine

# 🆕 КРИТИЧЕСКИ ВАЖНО: Устанавливаем библиотеки для Prisma в Alpine
RUN apk add --no-cache openssl libc6-compat

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# 🆕 Исправил порт на 3001, чтобы он совпадал с твоим docker-compose.yml
EXPOSE 3001 

CMD ["npm", "start"]